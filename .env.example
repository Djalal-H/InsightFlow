APP_ENV=development
LOG_LEVEL=INFO

# LiteLLM model identifiers, for example: openai/gpt-4.1-mini
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_CHAT_MODEL=
LITELLM_EMBEDDING_MODEL=
EMBEDDING_PROVIDER=
# Required for corpus ingestion. Set them from the embedding model's documentation.
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MAX_INPUT_TOKENS=8191
# Asymmetric embedding models embed questions and passages differently. Set both values for
# such a model (NVIDIA NIM retrieval models: query and passage; Cohere: search_query and
# search_document). Leave them empty for symmetric models such as OpenAI's. Without them, an
# asymmetric model gives almost random dense rankings. A change of the document type
# re-embeds every document at the next ingestion.
EMBEDDING_QUERY_INPUT_TYPE=
EMBEDDING_DOCUMENT_INPUT_TYPE=

# Add only the credentials required by the providers selected above.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=insightflow_documents
QDRANT_VECTOR_NAME=dense
# Sparse vector for hybrid retrieval; it exists only in collections created in hybrid mode.
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_DISTANCE=cosine

# Stage 3 RAG defaults. The ingestion CLI will receive the corpus path explicitly.
# RAG_CORPUS_DIR=/absolute/path/to/corpus
RAG_CHUNKING_STRATEGY=structure_recursive
RAG_CHUNK_TARGET_TOKENS=450
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_MIN_TOKENS=80
RAG_CHUNK_OVERLAP_TOKENS=0
# Max-Min settings apply when RAG_CHUNKING_STRATEGY=semantic_max_min.
RAG_MAX_MIN_HARD_THRESHOLD=0.6
RAG_MAX_MIN_SIMILARITY_COEFFICIENT=0.9
RAG_MAX_MIN_INITIALIZATION_CONSTANT=1.5
RAG_EMBEDDING_BATCH_SIZE=32
RAG_UPLOAD_BATCH_SIZE=64
RAG_CANDIDATE_TOP_K=12
RAG_GENERATION_MAX_CHUNKS=6
RAG_CONTEXT_TOKEN_BUDGET=6000

# Stage 6 retrieval options. Each one is off by default: turn one on after you compare it with
# `python -m insightflow.evaluate` (see "Retrieval quality" in README.md).
# dense, or hybrid (dense + lexical BM25 vectors, fused). Hybrid needs a collection that was
# created and ingested in hybrid mode; a dense-only collection is refused, not migrated.
RAG_RETRIEVAL_MODE=dense
# Minimum dense similarity for a candidate. Empty: no minimum.
# RAG_SCORE_THRESHOLD=0.2
# off, multi_query (other wordings of the question), or decompose (one query per fact).
# One chat call per search; the queries are searched together and fused.
RAG_QUERY_EXPANSION=off
RAG_QUERY_EXPANSION_MAX_QUERIES=3
# Hosted reranker through LiteLLM, for example cohere/rerank-v3.5 or
# nvidia_nim/nvidia/nv-rerankqa-mistral-4b-v3. Empty: no reranking. One billable call per search.
LITELLM_RERANK_MODEL=
# Optional. The key defaults to LITELLM_API_KEY; the base is not taken from LITELLM_API_BASE.
# LITELLM_RERANK_API_KEY=
# LITELLM_RERANK_API_BASE=
RAG_RERANK_TOP_N=6
# A chat model grades the passages, drops the irrelevant, and searches once more when none helps.
RAG_CORRECTIVE_RETRIEVAL_ENABLED=false
# Add this many neighboring chunks on each side of a hit to its passage (0-2).
RAG_NEIGHBORS_PER_HIT=0
# A chat model keeps only the sentences of each passage that help with the question.
RAG_CONTEXT_COMPRESSION_ENABLED=false
# Let the agent limit a search by file type or source path (adds two tool arguments).
RAG_SEARCH_FILTERS_ENABLED=false

# Agent workflow (ReAct): the agent searches documents and calls tools, then answers.
# Actions per attempt (1-8).
AGENT_MAX_STEPS=4
AGENT_VERIFIER_LLM_ENABLED=true
# Answers per question, including retries after a failed verification (1-4).
AGENT_MAX_ATTEMPTS=2
AGENT_HISTORY_TURNS=6
# Add a planning hint for questions that need several facts (one fact per search step).
AGENT_MULTI_HOP_ENABLED=false
# Retrieval-based conversation memory: embed each completed turn and recall the older turns of
# the thread that are similar to the new question. Needs a checkpoint backend and Qdrant; each
# turn makes two billable embedding calls.
MEMORY_ENABLED=false
MEMORY_COLLECTION=insightflow_memory
MEMORY_TOP_K=3
# Minimum similarity for a recalled turn. Empty: the MEMORY_TOP_K most similar older turns.
# MEMORY_SCORE_THRESHOLD=0.5
# Conversation checkpoints: none, memory, or sqlite.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite

# Stage 5 MCP tools, offered to the agent next to search_documents.
TOOL_CALCULATOR_ENABLED=true
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_OUTPUT_CHARS=6000
# A server whose listing fails, or whose call times out or is unavailable, is paused for this
# many seconds for all requests. 0 turns pauses off.
TOOL_FAILURE_COOLDOWN_SECONDS=60
# Tavily web search through its hosted MCP server. Requires TAVILY_API_KEY; calls are billable.
TOOL_WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
WEB_SEARCH_MAX_RESULTS=5
